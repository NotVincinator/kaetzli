+delwin_ripoffs(SCREEN *sp, WINDOW *win)
+{
+    if (win != NULL && sp != NULL) {
+	if (safe_ripoff_sp && safe_ripoff_sp != safe_ripoff_stack) {
+	    ripoff_t *rop;
