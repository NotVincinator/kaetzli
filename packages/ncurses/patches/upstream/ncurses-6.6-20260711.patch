+# otty
+#
+# https://github.com/otty-shell/otty
+#
+# an offshoot of alacritty, using
+#	https://github.com/jwilm/alacritty
+# as well as adapting features from iTerm2.  Written in rust, this is a MacOS
+# application with a port to Linux.
+#
+# tested version 1.2.2 with vttest and tack:
+# tack
+# + no flash
+# + no cvvis
+# + no status line
+# + no blink
+# + no invis
+# + has italics (with problems rendering) and strike-out
+# + has cursor movement (problem rendering "<>")
+# + has xterm-style shifted function/edit keys, but no control-/alt-modifiers
+# + no modifiers for cursor-keys
+# + no application mode for numeric keypad
+# vttest
+# + DA is \E[?62;22c, VT200 with color
+# + DA2 is \E[>0;2600;1c (perhaps inspired by iTerm2's \e[>41;2500;0c)
+# + no XTVERSION (contrary to its webpage)
+# + no SRM
+# + no DECSCA
+# + none of the mouse tests worked due to its problem displaying "*" character
+# + no ANSI and most DECRPM return anything but "unknown", except:
+#   DECCKM, DECOM, DECAWM, DECANAM, DECTCEM. DECGRPM, DECBKM
+# + no DECSCUSR
+# + cursor-movement generally works
+# other
+# + has title-stack
+# + does not accept colon for SGR subparameters
+# + has several color "themes", none matching xterm
+# + zsh-integration interferes with typing into other shells and applications
+otty|orchestration tty,
+	bce, ccc, mir, npc, xenl, xon, AX, XF, XT,
+	colors#0x100, pairs#0x10000,
+	acsc=``aaffggiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
+	civis=\E[?25l, clear=\E[H\E[2J, cnorm=\E[?25h, cub1=^H,
+	cud1=\n, ech=\E[%p1%dX, el1=\E[1K,
+	flash=\E[?5h$<100/>\E[?5l, indn=\E[%p1%dS,
+	initc=\E]4;%p1%d;rgb;%p2%'\377'%*%{1000}%/%2.2X/%p3%'\377'%*
+	      %{1000}%/%2.2X/%p4%'\377'%*%{1000}%/%2.2X\E\\,
+	is2=\E[!p\E[?3;4l\E[4l\E>, kDC=\E[3;2~, kEND=\E[1;2F,
+	kHOM=\E[1;2H, kIC=\E[2;2~, kNXT=\E[6;2~, kPRV=\E[5;2~,
+	kbs=^?, kcbt=\E[Z, kend=\EOF, kf10=\E[21~, kf11=\E[23~,
+	kf12=\E[24~, kf13=\E[1;2P, kf14=\E[1;2Q, kf15=\E[1;2R,
+	kf16=\E[1;2S, kf17=\E[15;2~, kf18=\E[17;2~,
+	kf19=\E[18;2~, kf20=\E[19;2~, kf21=\E[20;2~,
