+	    long my_errors = 0;
+	    long my_totals = 0;
+	    section = table[n].name;
+	    do_lo2hi(table[n].lo, table[n].hi, &my_errors, &my_totals);
+	    if (my_errors) {
+		if (section != NULL)
+		    printf("  => %s\n     ", section);
+		show_summary(my_errors, my_totals);
+	    }
+	    errors += my_errors;
+	    totals += my_totals;
+	}
+    } else if (optind >= argc)
 	usage();
     while (optind < argc) {
-	do_range(argv[optind++]);
+	do_range(argv[optind++], &errors, &totals);
     }
-    if (total_test) {
-	printf("%ld/%ld mismatches (%.0f%%)\n",
