+# ======================================================================
+
 # Read the fine man page:
 #       When  screen  tries  to  figure  out  a  terminal name for
 #       itself, it first looks for an entry named "screen.<term>",
@@ -8898,15 +8900,27 @@
 #	xterm (-xfree86 or -r6) does not normally support kIC, kNXT and kPRV
 #	since the default translations override the built-in keycode
 #	translation.  They are suppressed here to show what is tested by tack.
-screen.xterm-xfree86|screen.xterm-new|screen customized for modern xterm,
-	bce@, bw,
-	invis@, kIC@, kNXT@, kPRV@, meml@, memu@, rep@,
+#
+# The "83" in the secondary response (rv) is the decimal value of 'S'.
+screen4.xterm-new|screen.xterm-xfree86|screen4 customized for modern xterm,
+	bce@, bw, km@, npc,
+	U8#1,
+	dim=\E[2m, invis@, kIC@, kNXT@, kPRV@, kcbt=\E[Z, meml@, memu@,
+	nel=\EE, rep@,
 	sgr=%?%p9%t\E(0%e\E(B%;\E[0%?%p6%t;1%;%?%p2%t;4%;%?%p1%p3%|
 	    %t;7%;%?%p4%t;5%;%?%p5%t;2%;m,
-	E3@, use=screen+italics, use=screen+fkeys,
+	E3@, RV=\E[>c, rv=\E\\[>83;4[0-9][0-9][0-9];0c,
+	use=screen+italics, use=screen+fkeys,
 	use=xterm+x11mouse, use=ecma+index, use=ansi+rep,
-	use=ecma+strikeout, use=xterm+pcfkeys,
-	use=xterm+nofkeys,
+	use=xterm+pcfkeys, use=xterm+focus, use=xterm+sm+1006,
+	use=xterm+keypad, use=xterm-basic,
+
+screen5.xterm-new|screen5 customized for modern xterm,
+	dim=\E[2m, RV=\E[>c, rv=\E\\[>83;5[0-9][0-9][0-9];0c,
+	use=ecma+italics, use=screen.xterm-new,
+
+screen.xterm-new|screen customized for modern xterm,
+	use=screen4.xterm-new,
 
 # Don't use this, because not everyone has "screen.xterm-new":
 #:screen.xterm|screen for modern xterm,
@@ -9032,8 +9046,10 @@
