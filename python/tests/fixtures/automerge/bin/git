#!/bin/bash
# A fake git for the auto-merge harness: refs, ancestry and outcomes from files in $FAKE,
# every call logged. Only what tools/auto-merge does is understood; anything else fails.
set -u
echo "git $*" >> "$FAKE/log"
ref() { awk -v n="$1" '$1 == n { print $2; f = 1 } END { exit !f }' "$FAKE/refs"; }
set_ref() { { grep -v "^$1 " "$FAKE/refs" || true; echo "$1 $2"; } > "$FAKE/refs.new"; mv "$FAKE/refs.new" "$FAKE/refs"; }
resolve() { if [[ $1 =~ ^[0-9a-f]{40}$ ]]; then echo "$1"; else ref "$1"; fi; }
case "$1 ${2:-}" in
    "fetch --quiet") exit 0 ;;
    "rev-parse --short") s=$(resolve "$3") && echo "${s:0:7}" ;;
    "rev-parse "*) resolve "$2" ;;
    "merge-base --is-ancestor") grep -qx "$3 $(resolve "$4")" "$FAKE/ancestors" ;;
    "switch --quiet") set_ref HEAD "$5"; echo "$4" > "$FAKE/branch" ;;
    "rebase --quiet")
        b=$(cat "$FAKE/branch"); r=$(cat "$FAKE/rebase.${b//\//%}" 2>/dev/null || echo same)
        case "$r" in conflict) echo "CONFLICT (content): Merge conflict in env.sh" >&2; exit 1 ;;
                     same) exit 0 ;; *) set_ref HEAD "$r" ;; esac ;;
    "rebase --abort") exit 0 ;;
    "push --quiet")
        spec="${*:3}"
        if grep -qxF -e "$spec" "$FAKE/push-fails" 2>/dev/null; then
            echo "! [rejected] (non-fast-forward)" >&2; exit 1
        fi
        # what a push moves: origin/<branch> to HEAD, or origin/main to the commit
        to=${!#}
        case "$to" in
            HEAD:*) set_ref "origin/${to#HEAD:}" "$(ref HEAD)" ;;
            *:refs/heads/main) set_ref origin/main "${to%%:*}" ;;
        esac ;;
    *) echo "fake git: not understood: $*" >&2; exit 99 ;;
esac
