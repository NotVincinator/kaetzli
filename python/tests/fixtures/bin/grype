#!/usr/bin/env python3
"""A stand-in for grype: canned reports from $FAKE_GRYPE_REPORTS, named after the SBOM."""
import os
import re
import sys
from pathlib import Path

args = sys.argv[1:]
if args[:2] == ["db", "update"]:
    sys.exit(0)
if args[:2] == ["db", "status"]:
    print('{"schemaVersion": "v6", "built": "2026-11-01T04:12:33Z"}')
    sys.exit(0)
target = next(a for a in args if a.startswith("sbom:"))
doc = re.sub(r"^sbom-|\.sbom$", "", Path(target[5:]).stem)
log = os.environ.get("FAKE_GRYPE_LOG")
if log:
    with open(log, "a") as f:
        f.write(" ".join(["grype", *[Path(a).name if "/" in a else a for a in args]]) + "\n")
report = Path(os.environ["FAKE_GRYPE_REPORTS"]) / f"{doc}.json"
if not report.exists():
    sys.exit(1)
sys.stdout.write(report.read_text())
